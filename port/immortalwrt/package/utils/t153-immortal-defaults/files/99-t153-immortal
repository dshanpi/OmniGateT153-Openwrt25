#!/bin/sh
# Board defaults; persist a marker so restoring user configuration preserves it.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = dshanpi,t153mx-omnigate ] || exit 0
[ "$(uci -q get system.t153_immortal.applied)" = 1 ] && exit 0
uci -q batch <<'UCI' || exit 1
set luci.main.lang='zh_cn'
set luci.main.mediaurlbase='/luci-static/argon'
commit luci
UCI
# These services need user-specific uplinks/resolvers before activation.
if [ -f /etc/config/mwan3 ]; then
    /etc/init.d/mwan3 disable 2>/dev/null || true
    . /lib/functions.sh
    disable_mwan_interface() { uci -q set "mwan3.$1.enabled=0"; }
    config_load mwan3
    config_foreach disable_mwan_interface interface
    uci -q commit mwan3 || exit 1
fi
if [ -f /etc/config/smartdns ]; then
    /etc/init.d/smartdns disable 2>/dev/null || true
    uci -q set 'smartdns.@smartdns[0].enabled=0' || exit 1
    uci -q commit smartdns || exit 1
fi
if [ -f /etc/config/sms_tool_js ]; then
    # Do not prefill the upstream Polish telephone country prefix.
    uci -q set 'sms_tool_js.@sms_tool_js[0].prefix=0' || exit 1
    uci -q commit sms_tool_js || exit 1
fi
uci -q batch <<'UCI' || exit 1
set system.t153_immortal=t153_defaults
set system.t153_immortal.applied='1'
commit system
UCI
exit 0
