diff --git a/target/linux/sunxi/base-files/etc/board.d/02_network b/target/linux/sunxi/base-files/etc/board.d/02_network
index 073565d..cd1adbe 100644
--- a/target/linux/sunxi/base-files/etc/board.d/02_network
+++ b/target/linux/sunxi/base-files/etc/board.d/02_network
@@ -20,6 +20,7 @@ sunxi_setup_interfaces()
 	olimex,a13-olinuxino-micro)
 		ucidef_set_interface_lan "wlan0"
 		;;
+	dshanpi,t153mx-omnigate|\
 	xunlong,orangepi-r1)
 		ucidef_set_interfaces_lan_wan "eth0" "eth1"
 		;;
@@ -58,6 +59,16 @@ sunxi_setup_macs()
 	local label_mac=""
 
 	case "$board" in
+	dshanpi,t153mx-omnigate)
+		# T153 MAC from eMMC CID; block probe order is not a stable identity.
+		for mmc_path in /sys/block/mmcblk[0-9]*; do
+			[ "$(cat "$mmc_path/device/type" 2>/dev/null)" = MMC ] || continue
+			[ -r "$mmc_path/device/cid" ] || continue
+			lan_mac=$(macaddr_generate_from_mmc_cid "${mmc_path##*/}")
+			wan_mac=$(macaddr_add "$lan_mac" 1)
+			break
+		done
+		;;
 	friendlyarm,nanopi-r1)
 		wan_mac=$(nanopi_r1_get_mac wan)
 		lan_mac=$(nanopi_r1_get_mac lan)
@@ -75,6 +86,7 @@ sunxi_setup_macs()
 board_config_update
 board=$(board_name)
 sunxi_setup_interfaces $board
+[ "$board" = "dshanpi,t153mx-omnigate" ] && ucidef_set_interface lan ipaddr "192.168.153.1" netmask "255.255.255.0"
 sunxi_setup_macs $board
 board_config_flush
 
